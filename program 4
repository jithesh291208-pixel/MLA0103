import heapq

def astar(graph, heuristic, start, goal):
    pq = [(heuristic[start], 0, start, [start])]
    visited = set()

    while pq:
        f, cost, city, path = heapq.heappop(pq)

        if city == goal:
            print("Shortest Route:", path)
            print("Total Cost:", cost)
            return

        if city in visited:
            continue

        visited.add(city)

        for neighbor, distance in graph[city]:
            if neighbor not in visited:
                new_cost = cost + distance
                f = new_cost + heuristic[neighbor]

                heapq.heappush(
                    pq, (f, new_cost, neighbor,
                         path + [neighbor])
                )

graph = {
    'A': [('B', 4), ('C', 2)],
    'B': [('D', 5)],
    'C': [('D', 3), ('E', 6)],
    'D': [('E', 2)],
    'E': []
}

heuristic = {
    'A': 7,
    'B': 4,
    'C': 5,
    'D': 2,
    'E': 0
}

astar(graph, heuristic, 'A', 'E')
