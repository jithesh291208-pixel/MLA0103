def minimax(depth, is_max):
    if depth == 0:
        return 0

    if is_max:
        best = -float('inf')

        for score in [3, 5, 2]:
            value = score + minimax(depth - 1, False)
            best = max(best, value)

        return best

    else:
        best = float('inf')

        for score in [-2, -4, -1]:
            value = score + minimax(depth - 1, True)
            best = min(best, value)

        return best


