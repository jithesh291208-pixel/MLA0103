def greedy_routing(racks, start):
    visited = []
    current = start
    total_distance = 0

    while len(visited) < len(racks):
        nearest = None
        min_distance = float('inf')

        for rack, distance in racks[current].items():
            if rack not in visited and rack != current:
                if distance < min_distance:
                    min_distance = distance
                    nearest = rack

        if nearest is None:
            break

        print("Moving to:", nearest)

        total_distance += min_distance
        visited.append(nearest)
        current = nearest

    print("Total Travel Distance:", total_distance)


racks = {
    'A': {'B': 4, 'C': 2},
    'B': {'A': 4, 'C': 1, 'D': 5},
    'C': {'A': 2, 'B': 1, 'D': 3},
    'D': {'B': 5, 'C': 3}
}

greedy_routing(racks, 'A')
